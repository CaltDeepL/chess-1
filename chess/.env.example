# ローカル開発用。実際の値を .env にコピーして使う(.envはgit管理外)。
# 本番(Render)では .env は使わず、Renderダッシュボードの Environment に
# 同じキーで直接設定する。

# ローカルは docker-compose の db サービス、本番は Neon の接続文字列を使う
DATABASE_URL=postgres://chess:chess@localhost:5434/chess_db

# JWT署名用シークレット。未設定だと開発用の固定値にフォールバックするので
# 本番では必ず十分に長いランダム値を設定すること
JWT_SECRET=

# /internal/sweep の共有シークレット。ローカルで sweep を試す場合に設定する
SWEEP_TOKEN=

# CORSで許可するフロントエンドのオリジン(カンマ区切りで複数可)。
# 本番では Render のフロントエンドURLに置き換える
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# リッスンポート。Render等のPaaSはこの変数で使用ポートを渡してくるため、
# その場合は指定しないこと(プラットフォーム側の値がそのまま使われる)。
# ローカルでは未設定なら3000番を使う
PORT=3000

#プロジェクト	Postgres	API
#shisan-api	5432	8080
#ops-hub	5433	8081
#chess	5434	3000
